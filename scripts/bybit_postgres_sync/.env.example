# Bybit Postgres sync -- env template.
# Copy to `.env` in this directory on the Unraid host (and locally for dev).
#
# POSTGRES_PASSWORD is the only truly required value; the rest default to
# the user's Unraid instance (see _common.connect_db).

POSTGRES_HOST=192.168.1.53
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=luc
POSTGRES_PASSWORD=replace-me
